extends SceneTree
## Builds the 400 m and 6 km game worlds from Austin's 2 km ones (Austin, 2026-10-10: edit once, every size follows).
## Run: godot --headless --path . -s res://scripts/build/build_world_sizes.gd     (tools/sync_world_sizes.sh runs it)
## SIZES=400m,6km picks the sizes (default both). OUT_DIR=<absolute dir> writes there instead (a trial run; 2km works too).
##
## Sources (hand-edited; never written here):
##   art/world/export/world_landscape_2km.tscn  the inherited landscape: his tower sites with a Tower on each (slot_index,
##                                               per-tower jump landing overrides) hung under his markers
##   scenes/world/world.tscn                    the game world, with every place placed on the 2 km map
## Written (each starts with a GENERATED comment; edit the 2 km scenes and re-run):
##   art/world/export/world_landscape_<size>.tscn  the same things under the same markers of that size's glb: offsets from a
##        marker scale with the size's width and drop onto the ground; towers keep their size; each tower's jump landing is
##        recomputed on that size's ground; the tower's map floor and balcony camera follow the size (SIZE_TUNING).
##   scenes/world/world_<size>.tscn   world.tscn with that landscape and navmesh, and every placed node under World (and
##        the sites at the root) moved by the size's width around the origin and put on that size's ground at the same
##        height above it. Anything within TOWER_BOUND_M of a tower (its rally point, courier spawn, player spawn) keeps its
##        offset from the tower instead, because towers keep their size. Sun shadow distance follows the size.
## Also, before the sizes: every POI marker (his empties except the ones named *Tower) gets its place scene
##   art/world/pois/<snake>.tscn (an inherited scene of export/<snake>.glb, made here once and never rewritten: it is where Austin
##   adds Godot-only things) and an instance of it, named POI, under its marker in the 2 km landscape scene (added when missing,
##   nothing removed or duplicated). The derived sizes copy these instances: POIs keep their real size, like towers.
##   Forests and water grown from his guide outlines (scripts/build/world_areas.gd) go to art/world/export/world_areas_<size>.tscn,
##   instanced as Areas under the landscape root (2 km: added to the source scene the same way; other sizes: generated).
## The size's factors (wide, tall) are read off the exported grounds (tools/blender/export_landscape.py SIZES), not copied.
## Needs `godot --import` after the Blender export so the glbs are current. Then bake the navmeshes
## (tools/bake_open_world_navmesh.gd, WORLD=1) and the map pictures (tools/bake_map_illustration.gd).

const Ground = preload("res://scripts/build/world_ground.gd")
const Areas = preload("res://scripts/build/world_areas.gd")
const POI_GLB: String = "res://art/world/pois/export/%s.glb"
const POI_TSCN: String = "res://art/world/pois/%s.tscn"
const POI_NODE: String = "POI"
const AREAS_NODE: String = "Areas"
## Marker names ending like this are tower markers, not POIs.
const TOWER_MARKER_SUFFIX: String = "Tower"
const SOURCE_SIZE: String = "2km"
const LANDSCAPE_TSCN: String = "res://art/world/export/world_landscape_%s.tscn"
const LANDSCAPE_GLB: String = "res://art/world/export/world_landscape_%s.glb"
const AREAS_TSCN: String = "res://art/world/export/world_areas_%s.tscn"
const WORLD_SOURCE: String = "res://scenes/world/world.tscn"
const WORLD_TSCN: String = "res://scenes/world/world_%s.tscn"
const NAVMESH: String = "res://scenes/world/world_%s_navmesh.res"
const MAP_PICTURE: String = "res://scenes/map/map_illustration_%s.png"
const GENERATED: String = "; GENERATED by scripts/build/build_world_sizes.gd from the 2 km scenes; edit those and re-run\n; PLACEHOLDER: the layout is the 2 km scene's scaled by the size, not designed by Austin (tuning: SIZE_TUNING in the script)\n"
## Nodes inside the world that are placed on the map: containers whose children are placed, nodes placed one by one, and
## (below) any other Node3D child of the root, such as the corruption sites.
const PLACED_CONTAINERS: Array[String] = ["World/MapPoints", "World/Places", "World/Markers", "World/Enemies", "World/Interactables", "World/Minions"]
const PLACED_SINGLES: Array[String] = ["World/PlayerSpawnPoint", "World/Avatar"]
const ROOT_SKIPPED: Array[String] = ["World"]
## Placed nodes this close to a tower (2 km coordinates, metres) belong to it: its rally point, courier spawn, player spawn.
const TOWER_BOUND_M: float = 100.0
## How far above the ground a tower's jump lands (the 2 km scene's landings sit 0.15 m up; the navmesh lies 0.1 m up).
const NAV_ABOVE_GROUND: float = 0.15
## PLACEHOLDER: tuning, not designed. Turning a tower to fit a smaller or steeper ground (_turn_to_fit): the yaw step, the
## cost (metres of gate height off the 2 km one, plus this weight times the steepest slope within SLOPE_PROBE_M of the gate
## and of the jump landing) the 2 km yaw may have and still stay, and the probe radius.
const YAW_STEP_DEGREES: float = 15.0
const FIT_ACCEPT_COST: float = 4.0
const FIT_SLOPE_WEIGHT: float = 4.0
const SLOPE_PROBE_M: float = 6.0
## PLACEHOLDER: tuning, not designed. Placed nodes that are not on one of his markers (the roads, mines and the Avatar, put by
## eye on the 2 km map) move to the nearest spot not steeper than WALK_SLOPE (rise over run) when scaling drops them on a
## cliff, searched in rings of WALK_SEARCH_STEP_M up to WALK_SEARCH_MAX_M. "On a marker" is within ON_MARKER_M.
const WALK_SLOPE: float = 0.45
const WALK_SEARCH_STEP_M: float = 12.0
const WALK_SEARCH_MAX_M: float = 400.0
const ON_MARKER_M: float = 25.0
## PLACEHOLDER: tuning, not designed. A POI keeps its real size at every world size (it is buildings), so what stands in or
## beside one (a place, a site, a map point; anything within POI_BOUND_M of a marker, 2 km coordinates) keeps its real offset from
## the marker instead of scaling with the map, or on 400 m it would end up inside the buildings.
const POI_BOUND_M: float = 60.0
## PLACEHOLDER: tuning, not designed. A POI keeps its real size, so on a small map it can swallow a tower (Hell's Mouth, a 45 m
## cone with 130 m of collision, 98 m from the Volcano Tower at 2 km and 20 m at 400 m: the tower's units could not walk out).
## A generated size leaves out the POI instance of any marker closer than this (metres, that size) to a tower on another marker.
const POI_TOWER_CLEAR_M: float = 60.0
## PLACEHOLDER: tuning. A node placed by eye whose ground the baked navmesh of its size leaves more than this (metres) away is
## moved to the nearest spot whose ground it does not (the bake moves with every geometry change).
const NAV_SNAP_M: float = 1.0
## PLACEHOLDER: tuning, not designed. Per size: sun shadow distance (2 km: 400 m, in world.tscn) and the balcony lookout's
## far plane (2 km: 3500 m, in balcony.tscn): about the width of the map.
const SIZE_TUNING: Dictionary[String, Dictionary] = {
	"400m": {"shadow": 200.0, "balcony_far": 800.0},
	"2km": {"shadow": 400.0, "balcony_far": 3500.0},
	"6km": {"shadow": 800.0, "balcony_far": 10500.0},
}

var _failed: bool = false
var _out_dir: String = ""

func _init() -> void:
	_build.call_deferred()

func _build() -> void:
	# The game's autoloads exist only after the first frame; the scenes' scripts need them to compile.
	await process_frame
	_out_dir = OS.get_environment("OUT_DIR")
	var sizes := PackedStringArray(["400m", "6km"])
	if OS.get_environment("SIZES") != "":
		sizes = OS.get_environment("SIZES").split(",", false)
	var ref := Ground.new()
	ref.load_size(SOURCE_SIZE)
	_ensure_poi_scenes()
	for size in ["2km"] if sizes.has("2km") else (["2km"] + Array(sizes)):
		var area_ground := ref
		if size != SOURCE_SIZE:
			area_ground = Ground.new()
			area_ground.load_size(size)
		var report := Areas.new().build(size, area_ground, _marker_spots(size), self)
		if report == "":
			_failed = true
		print("[build] areas ", report)
	_ensure_areas_in_source()
	for size in sizes:
		var ground := Ground.new()
		ground.load_size(size)
		_size = size
		var baked := NAVMESH % size
		_ground_mesh = load(baked) as NavigationMesh if ResourceLoader.exists(baked) else null
		if _ground_mesh != null and _ground_mesh.get_polygon_count() == 0:
			_ground_mesh = null
		var factors := ground.factors_against(ref)
		print("[build] ", size, ": ", snappedf(factors.x, 0.001), " wide, ", snappedf(factors.y, 0.001), " tall")
		await _build_landscape(size, ref, ground, factors)
		_build_world(size, ref, ground, factors)
	quit(1 if _failed else 0)

# --- the landscape ---

func _build_landscape(size: String, ref: Ground, ground: Ground, factors: Vector2) -> void:
	## Written as text, like the hand-made 2 km scene: the glb as the base, then what hangs under his markers and the
	## properties set inside those (nothing of the glb's own contents is copied, so Godot's pack() is not used here).
	var source := load(LANDSCAPE_TSCN % SOURCE_SIZE) as PackedScene
	var state := source.get_state()
	var old_land: Node = source.instantiate()
	var land: Node = (load(LANDSCAPE_GLB % size) as PackedScene).instantiate()
	var tuning: Dictionary = SIZE_TUNING[size]
	var picture: String = MAP_PICTURE % size
	var have_picture := size != SOURCE_SIZE and ResourceLoader.exists(picture)
	if size != SOURCE_SIZE and not have_picture:
		push_warning("%s is missing: bake it (tools/bake_map_illustration.gd) and import, then re-run" % picture)
	var nodes: Array[Dictionary] = []
	var tower_markers: Array[String] = []   # the markers that carry a tower (a POI there shares the tower's ground)
	for i in range(1, state.get_node_count()):
		var carried := state.get_node_instance(i)
		if carried != null and carried.resource_path.ends_with("/tower.tscn"):
			tower_markers.append(String(state.get_node_path(i, true)).trim_prefix("./"))
	for i in range(1, state.get_node_count()):
		var path := String(state.get_node_path(i)).trim_prefix("./")
		var parent_path := String(state.get_node_path(i, true)).trim_prefix("./")
		var scene := state.get_node_instance(i)
		var props: Dictionary = {}
		for p in state.get_node_property_count(i):
			props[String(state.get_node_property_name(i, p))] = state.get_node_property_value(i, p)
		if scene != null:
			# Something his marker carries: instanced again, same properties, its offset from the marker re-snapped.
			# (A tower has a transform and a slot; a POI and the Areas have neither and are copied as they are, the Areas
			# of the same name but this size's file.)
			var scene_path: String = scene.resource_path
			if scene_path == AREAS_TSCN % SOURCE_SIZE:
				scene_path = AREAS_TSCN % size
				scene = load(scene_path) as PackedScene
			var parent := land.get_node(parent_path) as Node3D
			if size != SOURCE_SIZE and scene_path.begins_with("res://art/world/pois/") and not tower_markers.has(parent_path):
				var too_near := _tower_within(land, tower_markers, parent, POI_TOWER_CLEAR_M)
				if too_near != "":
					print("[build]   ", size, ": ", parent_path, "'s POI left out, ", too_near)
					continue
			var thing: Node = scene.instantiate()
			thing.name = state.get_node_name(i)
			parent.add_child(thing)
			if not (scene_path.begins_with("res://art/world/pois/") or scene_path.begins_with("res://art/world/export/world_areas_")):
				var old_thing := old_land.get_node(parent_path).get_node(String(thing.name)) as Node3D
				props["transform"] = _resnap_offset(props.get("transform", Transform3D.IDENTITY) as Transform3D, old_land.get_node(parent_path) as Node3D, parent, ref, ground, factors.x)
				for prop in props:
					thing.set(prop, props[prop])
				if size != SOURCE_SIZE and thing.has_node("CourierSpawn"):
					props["transform"] = await _turn_to_fit(thing as Node3D, old_thing, ref, ground)
					(thing as Node3D).transform = props["transform"]
			nodes.append({"parent": parent_path, "name": thing.name, "scene": scene_path, "index": -1, "props": props})
			if size != SOURCE_SIZE and thing.has_node("MapFloor"):
				_tower_overrides(nodes, thing, parent_path + "/" + String(thing.name), factors.x, tuning, picture if have_picture else "")
		else:
			# A property of something inside an instanced scene (an override): copied, except the jump landing.
			var node := land.get_node(path)
			if node is NavigationLink3D:
				props["end_position"] = _jump_landing(node as NavigationLink3D, props["end_position"] as Vector3, ground)
			nodes.append({"parent": parent_path, "name": node.name, "scene": "", "index": node.get_index(), "props": props})
	_save_landscape_text(size, nodes, picture if have_picture else "")
	land.free()
	old_land.free()

func _tower_within(land: Node, tower_markers: Array[String], marker: Node3D, metres: float) -> String:
	## "" or a note naming the tower marker within `metres` of this marker (across the ground).
	for t in tower_markers:
		var other := land.get_node(t) as Node3D
		var d := Vector2(other.position.x - marker.position.x, other.position.z - marker.position.z).length()
		if d < metres:
			return "%d m from the tower at %s" % [roundi(d), t]
	return ""

func _turn_to_fit(tower: Node3D, old_tower: Node3D, ref: Ground, ground: Ground) -> Transform3D:
	## A tower keeps its size, so on a smaller or steeper map its gate (the courier spawn) can hang over a drop or sink into
	## a slope. Its yaw is what the 2 km scene already chose by the ground ("toward the map centre unless the ground is
	## steep", a placeholder), so here it turns, in steps of YAW_STEP_DEGREES, until the gate and the jump landing stand on
	## the ground as they do at 2 km. The 2 km yaw stays when it already fits.
	var gate := tower.get_node("CourierSpawn") as Node3D
	var link := tower.find_child("JumpPoint", true, false) as NavigationLink3D
	var gate_local := gate.position
	var land_local := _relative(tower, link) * Vector3(link.end_position.x, 0.0, link.end_position.z)
	var old_gate_global := _global(old_tower) * gate_local
	var gate_above := old_gate_global.y - ref.y_at(old_gate_global.x, old_gate_global.z)
	var base := tower.transform
	var best := base
	var best_cost := INF
	var steps := int(360.0 / YAW_STEP_DEGREES)
	for k in steps:
		var candidate := Transform3D((Basis(Vector3.UP, deg_to_rad(YAW_STEP_DEGREES * k)) * base.basis).orthonormalized(), base.origin)
		tower.transform = candidate
		var at_gate := _global(tower) * gate_local
		var at_land := _global(tower) * land_local
		var g := ground.y_at(at_gate.x, at_gate.z)
		var l := ground.y_at(at_land.x, at_land.z)
		var cost := INF if is_nan(g) or is_nan(l) else absf((at_gate.y - g) - gate_above) + FIT_SLOPE_WEIGHT * (_slope(ground, at_gate) + _slope(ground, at_land))
		if cost < INF and not await _walks_out(tower, link, ground):
			cost = INF
		if k == 0 and cost <= FIT_ACCEPT_COST:
			tower.transform = base
			return base
		if cost < best_cost:
			best_cost = cost
			best = candidate
	tower.transform = best
	if best_cost == INF:
		push_warning("%s: no yaw lets a unit walk out of the tower at this size; keeping the 2 km yaw" % tower.get_parent().name)
		tower.transform = base
		return base
	print("[build]   ", tower.get_parent().name, " turned ", snappedf(rad_to_deg(Vector3.FORWARD.signed_angle_to(best.basis * Vector3.FORWARD, Vector3.UP)) - rad_to_deg(Vector3.FORWARD.signed_angle_to(base.basis * Vector3.FORWARD, Vector3.UP)), 1.0), " degrees (fit cost ", snappedf(best_cost, 0.1), ")")
	return best

var _size: String = ""
var _ground_mesh: NavigationMesh   # the size's baked ground mesh, when it exists (tools/bake_open_world_navmesh.gd)
var _scratch_map: RID
var _scratch_size: String = ""
var _scratch_regions: Array[RID] = []   # the tower's, then the ground's (the baked mesh, else a patch at the landing)
var _scratch_link: RID

func _walks_out(tower: Node3D, link: NavigationLink3D, ground: Ground) -> bool:
	## Whether a unit summoned in the tower, at its present pose, can walk to the jump link, jump and walk away: tried on a
	## scratch navigation map holding the tower's own navmesh, its jump link and a patch of ground at the landing. (Godot
	## joins a navmesh's polygons by position, so whether the tower's floor holds together depends on where and how it
	## stands: a tower that fits the ground can still strand its units.)
	var region_node := tower.get_node("NavigationRegion3D") as NavigationRegion3D
	var landing := _global(link) * _jump_landing(link, link.end_position, ground)
	if not _scratch_map.is_valid() or _scratch_size != _size:
		if _scratch_map.is_valid():
			NavigationServer3D.free_rid(_scratch_map)   # (its regions and link go with it)
			_scratch_regions.clear()
		_scratch_size = _size
		_scratch_map = NavigationServer3D.map_create()
		NavigationServer3D.map_set_cell_size(_scratch_map, float(ProjectSettings.get_setting("navigation/3d/default_cell_size", 0.25)))
		NavigationServer3D.map_set_cell_height(_scratch_map, float(ProjectSettings.get_setting("navigation/3d/default_cell_height", 0.25)))
		NavigationServer3D.map_set_edge_connection_margin(_scratch_map, float(ProjectSettings.get_setting("navigation/3d/default_edge_connection_margin", 0.25)))
		NavigationServer3D.map_set_link_connection_radius(_scratch_map, float(ProjectSettings.get_setting("navigation/3d/default_link_connection_radius", 1.0)))
		NavigationServer3D.map_set_active(_scratch_map, true)
		for i in 2:
			var region := NavigationServer3D.region_create()
			NavigationServer3D.region_set_map(region, _scratch_map)
			_scratch_regions.append(region)
		_scratch_link = NavigationServer3D.link_create()
		NavigationServer3D.link_set_map(_scratch_link, _scratch_map)
		NavigationServer3D.link_set_bidirectional(_scratch_link, false)
		for settle in 5:
			await physics_frame
	NavigationServer3D.region_set_transform(_scratch_regions[0], _global(region_node))
	NavigationServer3D.region_set_navigation_mesh(_scratch_regions[0], region_node.navigation_mesh)
	var y := landing.y - NAV_ABOVE_GROUND * 0.5
	if _ground_mesh != null:
		NavigationServer3D.region_set_navigation_mesh(_scratch_regions[1], _ground_mesh)
	else:
		var patch := NavigationMesh.new()
		patch.set_vertices(PackedVector3Array([Vector3(landing.x - 30.0, y, landing.z - 30.0), Vector3(landing.x - 30.0, y, landing.z + 30.0), Vector3(landing.x + 30.0, y, landing.z + 30.0), Vector3(landing.x + 30.0, y, landing.z - 30.0)]))
		patch.add_polygon(PackedInt32Array([0, 1, 2]))
		patch.add_polygon(PackedInt32Array([0, 2, 3]))
		NavigationServer3D.region_set_navigation_mesh(_scratch_regions[1], patch)
	NavigationServer3D.link_set_start_position(_scratch_link, _global(link) * link.start_position)
	NavigationServer3D.link_set_end_position(_scratch_link, landing)
	# The server takes the changes up over its next syncs (region changes first, then what hangs off them): wait for the
	# map's iteration to move on, then a few frames more.
	var iteration := NavigationServer3D.map_get_iteration_id(_scratch_map)
	NavigationServer3D.map_force_update(_scratch_map)
	for waited in 20:
		await physics_frame
		if NavigationServer3D.map_get_iteration_id(_scratch_map) != iteration:
			break
	for settle in 3:
		await physics_frame
	var spawn := _global(tower.get_node("MinionSpawnPoint") as Node3D).origin
	var target := Vector3(landing.x + 10.0, y, landing.z + 10.0)
	if _ground_mesh != null:
		# With the real ground the walk ends at the tower's gate.
		target = _global(tower.get_node("CourierSpawn") as Node3D).origin
	var path := NavigationServer3D.map_get_path(_scratch_map, spawn, target, true)
	if OS.get_environment("DEBUG_WALK") != "":
		print("[walk] ", tower.get_parent().name, " iter ", NavigationServer3D.map_get_iteration_id(_scratch_map), " path ", path.size(), " last ", path[path.size() - 1] if path.size() else "-", " target ", target)
	var arrived := not path.is_empty() and Vector2(path[path.size() - 1].x - target.x, path[path.size() - 1].z - target.z).length() < 2.0 and absf(path[path.size() - 1].y - target.y) < 3.0
	return arrived

func _slope(ground: Ground, at: Vector3) -> float:
	## Steepest rise of the ground within SLOPE_PROBE_M of a point (rise over run).
	var here := ground.y_at(at.x, at.z)
	var steepest := 0.0
	for k in 8:
		var d := Vector3.RIGHT.rotated(Vector3.UP, k * PI / 4.0) * SLOPE_PROBE_M
		var g := ground.y_at(at.x + d.x, at.z + d.z)
		if not is_nan(g) and not is_nan(here):
			steepest = maxf(steepest, absf(g - here) / SLOPE_PROBE_M)
	return steepest

func _relative(ancestor: Node3D, node: Node3D) -> Transform3D:
	return _global(ancestor).affine_inverse() * _global(node)

func _tower_overrides(nodes: Array[Dictionary], tower: Node, tower_path: String, wide: float, tuning: Dictionary, picture: String) -> void:
	## The tower's map floor shows this size's whole map (the picture is tools/bake_map_illustration.gd's, the rect is
	## the same scaling), and its balcony's far plane reaches across it.
	var floor_node := tower.get_node("MapFloor")
	var props: Dictionary = {"world_rect": Rect2(Vector2(-1000.0, -1000.0) * wide, Vector2(2000.0, 2000.0) * wide)}
	if picture != "":
		props["illustration"] = load(picture)
	nodes.append({"parent": tower_path, "name": floor_node.name, "scene": "", "index": floor_node.get_index(), "props": props})
	var camera := tower.get_node("Balcony/LookoutPivot/LookoutPitch/LookoutCamera")
	nodes.append({"parent": tower_path + "/Balcony/LookoutPivot/LookoutPitch", "name": camera.name, "scene": "", "index": camera.get_index(), "props": {"far": float(tuning["balcony_far"])}})

func _save_landscape_text(size: String, nodes: Array[Dictionary], picture: String) -> void:
	var glb := LANDSCAPE_GLB % size
	var ext: Array[String] = ["[ext_resource type=\"PackedScene\" uid=\"%s\" path=\"%s\" id=\"1_landscape\"]" % [_uid(glb), glb]]
	var ids: Dictionary = {}
	var text := ""
	for n in nodes:
		var line := "\n[node name=\"%s\" parent=\"%s\"" % [n["name"], n["parent"]]
		if n["scene"] != "":
			var scene: String = n["scene"]
			if not ids.has(scene):
				ids[scene] = "%d_%s" % [ids.size() + 2, scene.get_file().get_basename()]
				ext.append("[ext_resource type=\"PackedScene\"%s path=\"%s\" id=\"%s\"]" % [_uid_attr(scene), scene, ids[scene]])
			line += " instance=ExtResource(\"%s\")" % ids[scene]
		else:
			line += " index=\"%d\"" % n["index"]
		text += line + "]\n"
		if n["scene"] != "" and n["props"].has("slot_index"):
			text += "; PLACEHOLDER: which slot (0-3) is which site, and which way each tower faces, are the 2 km scene's, not designed\n"
		for prop in n["props"]:
			var value: Variant = n["props"][prop]
			if value is Texture2D:
				if not ids.has(picture):
					ids[picture] = "%d_picture" % (ids.size() + 2)
					ext.append("[ext_resource type=\"Texture2D\" path=\"%s\" id=\"%s\"]" % [picture, ids[picture]])
				text += "%s = ExtResource(\"%s\")\n" % [prop, ids[picture]]
			else:
				text += "%s = %s\n" % [prop, var_to_str(value)]
	_write(_landscape_path(size), "[gd_scene format=3]\n\n" + "\n".join(ext) + "\n\n[node name=\"WorldLandscape\" instance=ExtResource(\"1_landscape\")]\n" + text)

func _uid_attr(path: String) -> String:
	var id := _uid(path)
	return "" if id == "" else " uid=\"%s\"" % id

func _uid(path: String) -> String:
	var id := ResourceLoader.get_resource_uid(path)
	if id != ResourceUID.INVALID_ID:
		return ResourceUID.id_to_text(id)
	# a scene written in this run is not in the uid cache yet: read it off its first line
	if path.ends_with(".tscn") and FileAccess.file_exists(path):
		var head := FileAccess.get_file_as_string(path).get_slice("[gd_scene", 1).get_slice("]", 0)
		var found := RegEx.create_from_string("uid=\"(uid://[a-z0-9]+)\"").search(head)
		if found != null:
			return found.get_string(1)
	return ""


# --- POI scenes and the Areas, added to the 2 km source scene ---

func _poi_markers() -> Array[String]:
	## His POI markers: the empties of the 2 km ground file, except tower markers.
	var out: Array[String] = []
	var land: Node = (load(LANDSCAPE_GLB % SOURCE_SIZE) as PackedScene).instantiate()
	for c in land.get_children():
		if c is Node3D and not c is MeshInstance3D and not String(c.name).ends_with(TOWER_MARKER_SUFFIX):
			out.append(String(c.name))
	land.free()
	return out

func _snake(marker: String) -> String:
	## `Avequel'la` -> avequella, `Hell's Mouth` -> hells_mouth, `far harbor` -> far_harbor.
	return marker.to_lower().replace("'", "").replace(" ", "_")

func _marker_spots(size: String) -> Array[Vector2]:
	## Every marker (POIs and towers) of that size's ground, as x, z.
	var out: Array[Vector2] = []
	var land: Node = (load(LANDSCAPE_GLB % size) as PackedScene).instantiate()
	for c in land.get_children():
		if c is Node3D and not c is MeshInstance3D:
			out.append(Vector2((c as Node3D).position.x, (c as Node3D).position.z))
	land.free()
	return out

func _ensure_poi_scenes() -> void:
	## art/world/pois/<snake>.tscn for each POI marker whose export/<snake>.glb exists (made once, never rewritten), and an
	## instance of it under the marker in the 2 km landscape scene when that has none.
	var wanted: Array[Dictionary] = []
	for marker in _poi_markers():
		var snake := _snake(marker)
		if not ResourceLoader.exists(POI_GLB % snake):
			push_warning("%s: no %s; run tools/sync_world_sizes.sh (it exports the POI blockouts first)" % [marker, POI_GLB % snake])
			continue
		var scene_path: String = POI_TSCN % snake
		if not FileAccess.file_exists(scene_path):
			var glb: String = POI_GLB % snake
			var file := FileAccess.open(scene_path, FileAccess.WRITE)
			file.store_string("; Created by scripts/build/build_world_sizes.gd, once, and never rewritten: this is %s's place scene. Its look is\n; art/world/pois/export/%s.glb (from %s.blend, Austin edits that); add Godot-only things (lights, sites, sounds) here.\n; PLACEHOLDER: the look is a blockout stand-in, not designed by Austin\n[gd_scene format=3 uid=\"%s\"]\n\n[ext_resource type=\"PackedScene\" uid=\"%s\" path=\"%s\" id=\"1_glb\"]\n\n[node name=\"%s\" instance=ExtResource(\"1_glb\")]\n" % [marker, snake, snake, ResourceUID.id_to_text(ResourceUID.create_id()), _uid(glb), glb, snake.to_pascal_case()])
			file.close()
			print("[build] wrote ", scene_path)
		wanted.append({"parent": marker, "scene": scene_path, "id": "poi_" + snake})
	_add_to_source(wanted, POI_NODE, "; PLACEHOLDER: the place's look is a blockout stand-in (art/world/pois/*.blend), not designed by Austin")

func _ensure_areas_in_source() -> void:
	_add_to_source([{"parent": ".", "scene": AREAS_TSCN % SOURCE_SIZE, "id": "areas_2km"}], AREAS_NODE, "; PLACEHOLDER: forests and water grown inside his guide outlines (scripts/build/world_areas.gd), stand-ins")

func _add_to_source(wanted: Array[Dictionary], node_name: String, comment: String) -> void:
	## Adds `[node name=<node_name> parent=<parent> instance=...]` to the 2 km landscape scene for each wanted entry that the
	## scene does not have yet (same parent and same scene). Nothing is removed and nothing existing is touched.
	var path: String = LANDSCAPE_TSCN % SOURCE_SIZE
	var state := (load(path) as PackedScene).get_state()
	var present: Dictionary = {}
	for i in range(1, state.get_node_count()):
		var inst := state.get_node_instance(i)
		if inst != null:
			present[String(state.get_node_path(i, true)).trim_prefix("./") + "|" + inst.resource_path] = true
	var text := FileAccess.get_file_as_string(path)
	var ext := ""
	var body := ""
	var added := 0
	for w in wanted:
		var parent: String = w["parent"]
		if present.has(("." if parent == "." else parent) + "|" + String(w["scene"])):
			continue
		ext += "[ext_resource type=\"PackedScene\"%s path=\"%s\" id=\"%s\"]\n" % [_uid_attr(w["scene"]), w["scene"], w["id"]]
		body += "\n[node name=\"%s\" parent=\"%s\" instance=ExtResource(\"%s\")]\n%s\n" % [node_name, parent, w["id"], comment]
		added += 1
	if added == 0:
		return
	# the ext_resources after the last existing one, the nodes right after the root node (parents exist before children)
	var last_ext := text.rfind("[ext_resource")
	var after_ext := text.find("\n", last_ext) + 1
	text = text.substr(0, after_ext) + ext + text.substr(after_ext)
	var root_at := text.find("[node name=\"WorldLandscape\"")
	var after_root := text.find("\n", root_at) + 1
	text = text.substr(0, after_root) + body + text.substr(after_root)
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(text)
	file.close()
	print("[build] ", path, ": added ", added, " ", node_name, " instance(s)")

func _resnap_offset(local: Transform3D, old_parent: Node3D, new_parent: Node3D, ref: Ground, ground: Ground, wide: float) -> Transform3D:
	## An offset from its marker scales with the size's width and keeps its height above the ground (a marker that floats
	## 0.9 m above the ground at 2 km does not float 4.5 m above a 5x taller ground, so even no offset gets a height).
	var old_global := _global(old_parent) * local.origin
	var above := old_global.y - ref.y_at(old_global.x, old_global.z)
	var scaled := Vector3(local.origin.x * wide, local.origin.y, local.origin.z * wide)
	var new_global := _global(new_parent) * scaled
	var g := ground.y_at(new_global.x, new_global.z)
	if not is_nan(g):
		new_global.y = g + above
	local.origin = _global(new_parent).affine_inverse() * new_global
	return local

func _jump_landing(link: NavigationLink3D, old_end: Vector3, ground: Ground) -> Vector3:
	## The tower's jump-off link lands (in its own frame) where it did, but at the height of this size's ground there.
	var to_world := _global(link)
	var spot := to_world * Vector3(old_end.x, 0.0, old_end.z)
	var g := ground.y_at(spot.x, spot.z)
	if is_nan(g):
		return old_end
	var landing := Vector3(spot.x, g + NAV_ABOVE_GROUND, spot.z)
	var end_local := to_world.affine_inverse() * landing
	end_local.x = old_end.x
	end_local.z = old_end.z
	return end_local

func _global(node: Node) -> Transform3D:
	## Global transform of a node that is not in the tree (instancing the scenes outside it keeps their scripts quiet).
	var xf := Transform3D.IDENTITY
	var n: Node = node
	while n is Node3D:
		xf = (n as Node3D).transform * xf
		n = n.get_parent()
	return xf

# --- the game world ---

func _build_world(size: String, ref: Ground, ground: Ground, factors: Vector2) -> void:
	var world: Node = (load(WORLD_SOURCE) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_MAIN)
	var nav := world.get_node("World/Nav") as NavigationRegion3D
	var old_landscape := nav.get_node("WorldLandscape")
	var old_towers := _towers_of(old_landscape)
	var markers: Array[Vector3] = []   # his markers (the landscape's empties), 2 km coordinates
	for m in old_landscape.get_children():
		if m is Node3D and not m is MeshInstance3D and m.name != AREAS_NODE:
			markers.append((m as Node3D).position)
	nav.remove_child(old_landscape)
	var landscape: Node = (load(_landscape_path(size)) as PackedScene).instantiate(PackedScene.GEN_EDIT_STATE_INSTANCE)
	landscape.name = "WorldLandscape"
	nav.add_child(landscape)
	landscape.owner = world
	var new_towers := _towers_of(landscape)
	var navmesh_path: String = NAVMESH % size
	if not ResourceLoader.exists(navmesh_path):
		ResourceSaver.save(NavigationMesh.new(), navmesh_path)   # the bake fills it in place
	nav.navigation_mesh = load(navmesh_path) as NavigationMesh
	var moved := 0
	for placed in _placed_nodes(world):
		_place(placed, old_towers, new_towers, markers, ref, ground, factors)
		moved += 1
	var light := world.get_node("World/Atmosphere/DirectionalLight3D") as DirectionalLight3D
	light.directional_shadow_max_distance = float(SIZE_TUNING[size]["shadow"])
	# The curved-world bend follows the size: horizon with the width, eye height with the height (2 km values are the source's).
	var curve := world.get_node("World/Atmosphere/WorldCurve") as WorldCurve
	curve.horizon_m *= factors.x
	curve.eye_height_m *= factors.y
	print("[build] ", size, ": moved ", moved, " placed nodes")
	var packed := PackedScene.new()
	packed.pack(world)
	_save(packed, _world_path(size))
	old_landscape.free()
	world.free()

func _towers_of(landscape: Node) -> Array[Node3D]:
	var out: Array[Node3D] = []
	for t in landscape.find_children("*", "Node3D", true, false):
		if t.is_in_group(&"towers"):   # a Tower (tower.gd; its class is not named here because it needs the autoloads to compile)
			out.append(t as Node3D)
	return out

func _placed_nodes(world: Node) -> Array[Node3D]:
	var out: Array[Node3D] = []
	for path in PLACED_CONTAINERS:
		for c in world.get_node(path).get_children():
			if c is Node3D:
				out.append(c as Node3D)
	for path in PLACED_SINGLES:
		out.append(world.get_node(path) as Node3D)
	for c in world.get_children():
		if c is Node3D and not ROOT_SKIPPED.has(String(c.name)):
			out.append(c as Node3D)
	return out

func _place(node: Node3D, old_towers: Array[Node3D], new_towers: Array[Node3D], markers: Array[Vector3], ref: Ground, ground: Ground, factors: Vector2) -> void:
	## Everything placed sits under identity-transform parents, so its position is its global position.
	var old_pos := node.position
	var near := -1
	var near_d := TOWER_BOUND_M
	for i in old_towers.size():
		var d := old_pos.distance_to(_global(old_towers[i]).origin)
		if d < near_d:
			near_d = d
			near = i
	if near >= 0:
		# Towers keep their size, so what stands beside one keeps its offset from it (match by slot, not by list order).
		var new_tower := _tower_with_slot(new_towers, int(old_towers[near].get("slot_index")))
		# (the tower may have been turned to fit this size's ground: its neighbours turn with it)
		var turn := _global(new_tower).basis * _global(old_towers[near]).basis.inverse()
		node.position = _global(new_tower).origin + turn * (old_pos - _global(old_towers[near]).origin)
		node.basis = turn * node.basis
		print("[build]   ", node.name, " follows ", old_towers[near].get_parent().name)
		return
	var x := old_pos.x * factors.x
	var z := old_pos.z * factors.x
	for m in markers:
		if Vector2(m.x - old_pos.x, m.z - old_pos.z).length() <= POI_BOUND_M:
			x = m.x * factors.x + (old_pos.x - m.x)
			z = m.z * factors.x + (old_pos.z - m.z)
			break
	if not _on_marker(old_pos, markers):
		var spot := _walkable_spot(ground, x, z)
		if spot != Vector2(x, z):
			print("[build]   ", node.name, " (placed by eye) moved ", snappedf(spot.distance_to(Vector2(x, z)), 1.0), " m off steep ground")
		x = spot.x
		z = spot.y
	var old_g := ref.y_at(old_pos.x, old_pos.z)
	var new_g := ground.y_at(x, z)
	var y := old_pos.y * factors.y
	if not is_nan(old_g) and not is_nan(new_g):
		y = new_g + (old_pos.y - old_g)
	node.position = Vector3(x, y, z)
	if _ground_mesh != null and not _on_marker(old_pos, markers) and not is_nan(new_g):
		var spot := _spot_on_navmesh(ground, Vector2(x, z))
		if spot != Vector2(x, z):
			print("[build]   ", node.name, " (placed by eye) moved ", snappedf(spot.distance_to(Vector2(x, z)), 0.1), " m to stand on the navmesh")
			node.position = Vector3(spot.x, ground.y_at(spot.x, spot.y) + (y - new_g), spot.y)

func _spot_on_navmesh(ground: Ground, at: Vector2) -> Vector2:
	## `at` when the ground there lies within NAV_SNAP_M of the size's baked navmesh (a baked triangle can sit metres off
	## the ground on a steep slope, and a map point drops onto the ground), else the nearest spot in rings of 2 m, up to 40 m,
	## where it does.
	var r := 0.0
	while r <= 40.0:
		for k in (1 if r == 0.0 else 16):
			var p := at + Vector2.RIGHT.rotated(k * TAU / 16.0) * r
			var g := ground.y_at(p.x, p.y)
			if not is_nan(g) and _distance_to_navmesh(Vector3(p.x, g, p.y)) <= NAV_SNAP_M:
				return p
		r += 2.0
	return at

var _nav_cells: Dictionary[Vector2i, PackedInt32Array] = {}   # the baked mesh's triangles by 16 m cell, built on first use
var _nav_cells_for: NavigationMesh

func _distance_to_navmesh(p: Vector3) -> float:
	## Distance from p to the nearest triangle of the baked navmesh (only the triangles in the cells around p are tried).
	var verts := _ground_mesh.get_vertices()
	if _nav_cells_for != _ground_mesh:
		_nav_cells_for = _ground_mesh
		_nav_cells.clear()
		for i in _ground_mesh.get_polygon_count():
			var poly := _ground_mesh.get_polygon(i)
			var lo := Vector2(INF, INF)
			var hi := Vector2(-INF, -INF)
			for idx in poly:
				lo = lo.min(Vector2(verts[idx].x, verts[idx].z))
				hi = hi.max(Vector2(verts[idx].x, verts[idx].z))
			for cx in range(floori(lo.x / 16.0), floori(hi.x / 16.0) + 1):
				for cz in range(floori(lo.y / 16.0), floori(hi.y / 16.0) + 1):
					var key := Vector2i(cx, cz)
					if not _nav_cells.has(key):
						_nav_cells[key] = PackedInt32Array()
					_nav_cells[key].append(i)
	var best := INF
	for cx in range(floori((p.x - 16.0) / 16.0), floori((p.x + 16.0) / 16.0) + 1):
		for cz in range(floori((p.z - 16.0) / 16.0), floori((p.z + 16.0) / 16.0) + 1):
			for i in _nav_cells.get(Vector2i(cx, cz), PackedInt32Array()):
				var poly := _ground_mesh.get_polygon(i)
				for k in range(1, poly.size() - 1):
					best = minf(best, _closest_on_triangle(p, verts[poly[0]], verts[poly[k]], verts[poly[k + 1]]).distance_to(p))
	return best

func _closest_on_triangle(p: Vector3, a: Vector3, b: Vector3, c: Vector3) -> Vector3:
	## Ericson, Real-Time Collision Detection 5.1.5.
	var ab := b - a
	var ac := c - a
	var ap := p - a
	var d1 := ab.dot(ap)
	var d2 := ac.dot(ap)
	if d1 <= 0.0 and d2 <= 0.0:
		return a
	var bp := p - b
	var d3 := ab.dot(bp)
	var d4 := ac.dot(bp)
	if d3 >= 0.0 and d4 <= d3:
		return b
	var vc := d1 * d4 - d3 * d2
	if vc <= 0.0 and d1 >= 0.0 and d3 <= 0.0:
		return a + ab * (d1 / (d1 - d3))
	var cp := p - c
	var d5 := ab.dot(cp)
	var d6 := ac.dot(cp)
	if d6 >= 0.0 and d5 <= d6:
		return c
	var vb := d5 * d2 - d1 * d6
	if vb <= 0.0 and d2 >= 0.0 and d6 <= 0.0:
		return a + ac * (d2 / (d2 - d6))
	var va := d3 * d6 - d5 * d4
	if va <= 0.0 and (d4 - d3) >= 0.0 and (d5 - d6) >= 0.0:
		return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)))
	var denom := 1.0 / (va + vb + vc)
	return a + ab * (vb * denom) + ac * (vc * denom)

func _on_marker(at: Vector3, markers: Array[Vector3]) -> bool:
	for m in markers:
		if Vector2(m.x - at.x, m.z - at.z).length() <= ON_MARKER_M:
			return true
	return false

func _walkable_spot(ground: Ground, x: float, z: float) -> Vector2:
	## The nearest spot to (x, z) whose ground is not steeper than WALK_SLOPE (the spot itself when it is not).
	var from := Vector3(x, 0.0, z)
	if _slope(ground, from) <= WALK_SLOPE:
		return Vector2(x, z)
	var r := WALK_SEARCH_STEP_M
	while r <= WALK_SEARCH_MAX_M:
		for k in 16:
			var d := Vector3.RIGHT.rotated(Vector3.UP, k * TAU / 16.0) * r
			if _slope(ground, from + d) <= WALK_SLOPE:
				return Vector2(x + d.x, z + d.z)
		r += WALK_SEARCH_STEP_M
	return Vector2(x, z)

func _tower_with_slot(towers: Array[Node3D], slot: int) -> Node3D:
	for t in towers:
		if int(t.get("slot_index")) == slot:
			return t
	return towers[0]

# --- output ---

func _landscape_path(size: String) -> String:
	return (_out_dir + "/world_landscape_%s.tscn" % size) if _out_dir != "" else LANDSCAPE_TSCN % size

func _world_path(size: String) -> String:
	return (_out_dir + "/world_%s.tscn" % size) if _out_dir != "" else WORLD_TSCN % size

func _save(packed: PackedScene, path: String) -> void:
	var err := ResourceSaver.save(packed, path)
	if err != OK:
		push_error("could not save %s (%d)" % [path, err])
		_failed = true
		return
	var file := FileAccess.open(ProjectSettings.globalize_path(path), FileAccess.READ)
	var text := file.get_as_text()
	file.close()
	# pack() gives every node a fresh random unique_id each run, which would make every sync a diff: Godot assigns
	# them again when the scene loads, so they are left out.
	var ids := RegEx.create_from_string(" unique_id=[0-9]+")
	_write(path, ids.sub(text, "", true))

func _write(path: String, text: String) -> void:
	var file := FileAccess.open(ProjectSettings.globalize_path(path), FileAccess.WRITE)
	if file == null:
		push_error("could not write %s" % path)
		_failed = true
		return
	file.store_string(GENERATED + text)
	file.close()
	print("[build] wrote ", path)
