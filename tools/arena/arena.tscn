[ext_resource type="PackedScene" path="res://scenes/actors/boss/boss_actor.tscn" id="3_boss"]
[ext_resource type="PackedScene" uid="uid://dsnyn2e8y152j" path="res://scenes/actors/player/avatar/avatar_actor.tscn" id="4_avatar"]
[ext_resource type="Script" path="res://scripts/minion_manager.gd" id="5_mm"]
[ext_resource type="Script" path="res://scripts/groups/group_manager.gd" id="6_gm"]
[ext_resource type="PackedScene" path="res://scenes/world/places/body.tscn" id="7_body"]
[ext_resource type="Script" path="res://tools/arena/arena_panel.gd" id="8_panel"]

[sub_resource type="Environment" id="Environment_arena"]
background_mode = 1
background_color = Color(0.32, 0.34, 0.38, 1)
ambient_light_source = 2
ambient_light_color = Color(0.55, 0.55, 0.6, 1)

; Baked at start (arena.gd): the same settings as the test stage's floor (tests/support/stage_test.gd).
[sub_resource type="NavigationMesh" id="NavigationMesh_arena"]
geometry_parsed_geometry_type = 1
cell_size = 0.25
cell_height = 0.25
agent_height = 3.0
agent_radius = 0.75

[sub_resource type="BoxShape3D" id="BoxShape3D_floor"]
size = Vector3(60, 1, 60)

[sub_resource type="BoxShape3D" id="BoxShape3D_ledge"]
size = Vector3(4, 1, 4)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_floor"]
albedo_color = Color(0.42, 0.4, 0.36, 1)
roughness = 1.0

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
material = SubResource("StandardMaterial3D_floor")
size = Vector3(60, 1, 60)

[node name="Arena" type="Node3D"]
script = ExtResource("1_arena")
config = ExtResource("2_preset")
boss_scene = ExtResource("3_boss")

[node name="World" type="Node3D" parent="."]

[node name="Sun" type="DirectionalLight3D" parent="World"]
transform = Transform3D(0.866, -0.354, 0.354, 0, 0.707, 0.707, -0.5, -0.612, 0.612, 0, 20, 0)
shadow_enabled = true

[node name="WorldEnvironment" type="WorldEnvironment" parent="World"]
environment = SubResource("Environment_arena")

[node name="Nav" type="NavigationRegion3D" parent="World"]
navigation_mesh = SubResource("NavigationMesh_arena")

[node name="Ground" type="StaticBody3D" parent="World/Nav"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="World/Nav/Ground"]
shape = SubResource("BoxShape3D_floor")

[node name="MeshInstance3D" type="MeshInstance3D" parent="World/Nav/Ground"]
mesh = SubResource("BoxMesh_floor")

; The Paladin lives at this path, as in the game world (BossAI and DebugManager look for World/Avatar).
[node name="Avatar" parent="World" instance=ExtResource("4_avatar")]

[node name="Bosses" type="Node3D" parent="World"]

; Where you start, and where your opponent starts (facing each other), inside the AI Paladin's (10 m) and
; the minions' (MinionType.aggro_radius, 8 m by default) aggro range, so AI opponents engage at once.
[node name="PlayerSpot" type="Marker3D" parent="World"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 3.5)

[node name="FoeSpot" type="Marker3D" parent="World"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -3.5)

; The Paladin waits here, hidden and unhurt, in rounds without him: a ledge off the floor, out of everyone's aggro range.
[node name="ParkedSpot" type="Marker3D" parent="World"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 50, 0, 50)

[node name="ParkedLedge" type="StaticBody3D" parent="World/ParkedSpot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="World/ParkedSpot/ParkedLedge"]
shape = SubResource("BoxShape3D_ledge")

; Shown to whoever drives nothing (before a round, or a peer left watching).
[node name="OverviewCamera" type="Camera3D" parent="World"]
transform = Transform3D(1, 0, 0, 0, 0.774, 0.633, 0, -0.633, 0.774, 0, 18, 22)
current = true

[node name="Minions" type="Node3D" parent="."]

[node name="MinionManager" type="Node" parent="." node_paths=PackedStringArray("minions_root")]
script = ExtResource("5_mm")
