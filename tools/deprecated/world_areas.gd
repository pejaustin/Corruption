extends RefCounted
## Forests and water for one world size, grown from Austin's guide outlines (`elder wood`, `northwood`, `Pale River`,
## `The Still Lake` in world_landscape.blend, exported as art/world/export/areas_<size>.json by tools/blender/export_landscape.py).
## Used by scripts/build/build_world_sizes.gd: `const Areas = preload("res://scripts/build/world_areas.gd")`.
##
## Writes art/world/export/world_areas_<size>.tscn (GENERATED; the landscape scenes instance it under the root):
##   Forests/<guide name>/<chunk>   MultiMeshInstance3D chunks of stand-in trees (props.blend tree_cone / tree_lollipop,
##                                  art/world/export/props/*.glb) standing on the ground, no collision
##   Waters/<guide name>            scenes/world/water/water_body.tscn per water outline: a river, a lake or the sea
##                                  (Austin, 2026-10-12: his planes are location markers; the ground under them is sunk in
##                                  Blender by tools/blender/carve_water.py). The river and the sea block movement: a
##                                  NavigationObstacle3D per outline cuts them out of the navmesh, and bank walls stop bodies;
##                                  the river stays open at each RiverCrossing (river_crossing.tscn, hung under the towns in
##                                  world_landscape_2km.tscn). The lake can be waded.
## PLACEHOLDER: everything here is a stand-in, not designed by Austin: the tree choice, density, scale, clearings, chunk size,
## visibility ranges and the water levels and offsets below (listed in PLACEHOLDERS.md).

const Ground = preload("res://scripts/build/world_ground.gd")
const AREAS_JSON: String = "res://art/world/export/areas_%s.json"
const AREAS_TSCN: String = "res://art/world/export/world_areas_%s.tscn"
const TREE_GLBS: Array[String] = ["res://art/world/export/props/tree_cone.glb", "res://art/world/export/props/tree_lollipop.glb"]
const WATER_SCENE: PackedScene = preload("res://scenes/world/water/water_body.tscn")
const CROSSING_SCENE: String = "res://scenes/world/water/river_crossing.tscn"
const LANDSCAPE_SOURCE: String = "res://art/world/export/world_landscape_2km.tscn"
const LANDSCAPE_GLB: String = "res://art/world/export/world_landscape_%s.glb"
const FOREST_MATERIAL: String = "res://art/world/materials/forest_placeholder.tres"
const GENERATED: String = "; GENERATED by scripts/build/world_areas.gd (run by build_world_sizes.gd) from art/world/export/areas_<size>.json; edit the guides in world_landscape.blend and re-run tools/sync_world_sizes.sh\n; PLACEHOLDER: tree choice, density, scale, clearings, chunks, visibility ranges and water levels are stand-ins, not designed by Austin\n"

## PLACEHOLDER: trees per square metre (one per 100 m2, about 10 m apart; jittered grid), the random scale range, and the
## trunk-ground sink. Trees keep their real size at every world size (like buildings and towers), so a bigger map has more.
const TREE_SPACING_M: float = 10.0
const TREE_SCALE_MIN: float = 0.8
const TREE_SCALE_MAX: float = 1.3
const TREE_SINK_M: float = 0.2
## PLACEHOLDER: no trees this close to a marker (a POI or tower stands there), and not on slopes steeper than this.
const MARKER_CLEAR_M: float = 60.0
const TREE_MAX_SLOPE: float = 0.9
## PLACEHOLDER: trees are grown in chunks of this many metres a side; a chunk is hidden beyond VISIBILITY_END_M[size].
const CHUNK_M: float = 200.0
const VISIBILITY_END_M: Dictionary[String, float] = {"400m": 500.0, "2km": 1500.0, "6km": 3500.0}
## PLACEHOLDER: water levels. The ground is sunk under each outline in Blender (carve_water.py), so the water sits below the
## ground on its outline: a river RIVER_BELOW_BANK_M under its nearest bank (its strip split to RIVER_EDGE_M so it follows the
## banks), a lake LAKE_BELOW_RIM_M under the lowest ground on its outline, the sea at the height of Austin's ocean plane. Before
## the sink the river and the lake are under the ground and do not show. Heights are 2 km values and scale with the size's
## height; lengths scale with its width.
const LAKE_BELOW_RIM_M: float = 0.3
const RIVER_BELOW_BANK_M: float = 1.0
const RIVER_EDGE_M: float = 12.0
const BANK_SAMPLE_M: float = 4.0
## PLACEHOLDER: the bank walls stand WALL_HEIGHT_M over the higher bank (real metres at every size) and reach WALL_DEPTH_M
## under the lower bank or the water; the navmesh blockers reach BLOCKER_PAD_M past the lowest and highest bank.
const WALL_HEIGHT_M: float = 4.0
const WALL_DEPTH_M: float = 10.0
## The river's walls are about 10 ft high (Austin, 2026-10-13): from RIVER_WALL_BELOW_M under the lower bank to
## RIVER_WALL_ABOVE_M over the higher one (3.05 m where the banks are level). Real metres at every size.
const RIVER_WALL_BELOW_M: float = 0.5
const RIVER_WALL_ABOVE_M: float = 2.55
const BLOCKER_PAD_M: float = 50.0
const CROSSING_SIDES: int = 24
## A guide of kind "water" whose name contains this is a river, any other a lake.
const RIVER_WORD: String = "river"

var _ground: Ground
var _size: String
var _markers: Array[Vector2] = []   # his markers on this size's map (x, z)
var _water_loops: Array[PackedVector2Array] = []
var _tree_meshes: Array[Mesh] = []
var _buffers: Dictionary[String, PackedFloat32Array] = {}   # "<forest>/<chunk>" -> the chunk's instance transforms

func build(size: String, ground: Ground, markers: Array[Vector2], owner_tree: SceneTree) -> String:
	## Returns the report line (trees, chunks, water vertices). Writes AREAS_TSCN.
	_size = size
	_ground = ground
	_markers = markers
	var json := JSON.parse_string(FileAccess.get_file_as_string(AREAS_JSON % size)) as Dictionary
	var areas: Dictionary = json["areas"]
	for glb in TREE_GLBS:
		_tree_meshes.append(_tree_mesh(glb))
	var root := Node3D.new()
	root.name = "WorldAreas"
	var forests := Node3D.new()
	forests.name = "Forests"
	root.add_child(forests)
	forests.owner = root
	var waters := Node3D.new()
	waters.name = "Waters"
	root.add_child(waters)
	waters.owner = root
	for name in areas:
		if areas[name]["kind"] in ["water", "sea"]:
			_water_loops.append(_loop(areas[name]))
	var crossings := _crossings(size, float(json.get("wide", 1.0)))
	var trees := 0
	var chunks := 0
	var water_verts := 0
	for name in areas:
		var area: Dictionary = areas[name]
		match String(area["kind"]):
			"forest":
				var counts := _grow_forest(forests, root, name, area)
				trees += counts.x
				chunks += counts.y
			"water", "sea":
				water_verts += _make_water(waters, root, name, area, crossings)
			_:
				push_warning("%s: guide '%s' is neither forest nor water; ignored" % [size, name])
	var packed := PackedScene.new()
	packed.pack(root)
	var path: String = AREAS_TSCN % size
	var header_uid := RegEx.create_from_string("uid=\"(uid://[a-z0-9]+)\"").search(FileAccess.get_file_as_string(path).get_slice("[gd_scene", 1).get_slice("]", 0)) if FileAccess.file_exists(path) else null
	var scene_uid := header_uid.get_string(1) if header_uid != null else ResourceUID.id_to_text(ResourceUID.create_id())
	root.free()
	var err := ResourceSaver.save(packed, path)
	if err != OK:
		push_error("could not save %s (%d)" % [path, err])
		return ""
	var text := FileAccess.get_file_as_string(path)
	text = RegEx.create_from_string(" unique_id=[0-9]+").sub(text, "", true)
	text = _insert_buffers(text)
	if not text.get_slice("]", 0).contains("uid="):
		text = RegEx.create_from_string("\\[gd_scene format=(\\d+)").sub(text, "[gd_scene format=$1 uid=\"%s\"" % scene_uid)
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(GENERATED + text)
	file.close()
	return "%s: %d trees in %d chunks (visible to %d m), %d water vertices, %d KB" % [size, trees, chunks, int(VISIBILITY_END_M[size]), water_verts, FileAccess.get_file_as_bytes(path).size() / 1024]

func _insert_buffers(text: String) -> String:
	## Puts `buffer = PackedFloat32Array(...)` into each chunk's MultiMesh sub-resource (the saver wrote none).
	var lines := text.split("\n")
	var node_name := ""
	var parent := ""
	var ids: Dictionary[String, String] = {}   # sub-resource id -> buffer key
	var node_re := RegEx.create_from_string("^\\[node name=\"([^\"]*)\".*parent=\"Forests/([^\"]*)\"")
	for line in lines:
		if line.begins_with("[node "):
			var m := node_re.search(line)
			node_name = m.get_string(1) if m != null else ""
			parent = m.get_string(2) if m != null else ""
		elif line.begins_with("multimesh = SubResource(\"") and node_name != "":
			ids[line.get_slice("\"", 1)] = "%s/%s" % [parent, node_name]
	var out: PackedStringArray = []
	var current := ""
	for line in lines:
		if line.begins_with("[sub_resource type=\"MultiMesh\""):
			current = line.get_slice("id=\"", 1).get_slice("\"", 0)
		elif line.begins_with("[") or line == "":
			if current != "" and ids.has(current):
				var buf: PackedFloat32Array = _buffers[ids[current]]
				var parts := PackedStringArray()
				for f in buf:
					parts.append(String.num(f, 3))
				out.append("buffer = PackedFloat32Array(%s)" % ", ".join(parts))
			current = ""
		out.append(line)
	return "\n".join(out)

func _tree_mesh(glb: String) -> Mesh:
	## The tree's mesh with the forest look on its leaves (forest_placeholder) and the blockout's bark on the trunk.
	var scene := (load(glb) as PackedScene).instantiate()
	var mi := scene.find_children("*", "MeshInstance3D", true, false)[0] as MeshInstance3D
	var mesh := mi.mesh.duplicate() as ArrayMesh
	for i in mesh.get_surface_count():
		var material := mesh.surface_get_material(i)
		if material != null and material.resource_name.begins_with("mat_leaf"):
			mesh.surface_set_material(i, load(FOREST_MATERIAL) as Material)
	scene.free()
	return mesh

func _loop(area: Dictionary) -> PackedVector2Array:
	var loop := PackedVector2Array()
	for p in (area["outlines"] as Array)[0]:
		loop.append(Vector2(p[0], p[1]))
	return loop

# --- forests ---

func _grow_forest(forests: Node3D, owner_node: Node, name: String, area: Dictionary) -> Vector2i:
	var loop := _loop(area)
	var bounds := Rect2(loop[0], Vector2.ZERO)
	for p in loop:
		bounds = bounds.expand(p)
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(name + _size)
	# spots: a jittered grid, kept inside the outline, clear of markers and water, on walkable-ish ground
	var by_chunk: Dictionary[Vector2i, Array] = {}
	var x := bounds.position.x
	while x < bounds.end.x:
		var z := bounds.position.y
		while z < bounds.end.y:
			var p := Vector2(x + rng.randf() * TREE_SPACING_M, z + rng.randf() * TREE_SPACING_M)
			z += TREE_SPACING_M
			if not Geometry2D.is_point_in_polygon(p, loop) or _blocked(p):
				continue
			var y := _ground.y_at(p.x, p.y)
			if is_nan(y) or _slope(p) > TREE_MAX_SLOPE:
				continue
			var key := Vector2i(floori(p.x / CHUNK_M), floori(p.y / CHUNK_M))
			if not by_chunk.has(key):
				by_chunk[key] = []
			by_chunk[key].append(Vector3(p.x, y, p.y))
		x += TREE_SPACING_M
	var holder := Node3D.new()
	holder.name = name
	forests.add_child(holder)
	holder.owner = owner_node
	var trees := 0
	var keys := by_chunk.keys()
	keys.sort()
	for key in keys:
		var spots: Array = by_chunk[key]
		var per_kind: Array[Array] = []
		for k in _tree_meshes.size():
			per_kind.append([])
		for spot in spots:
			per_kind[rng.randi() % _tree_meshes.size()].append(spot)
		for k in _tree_meshes.size():
			if per_kind[k].is_empty():
				continue
			var mm := MultiMesh.new()
			mm.transform_format = MultiMesh.TRANSFORM_3D
			mm.mesh = _tree_meshes[k]
			mm.instance_count = per_kind[k].size()
			# (the transforms go into the scene text by hand, see _insert_buffers: a headless run has no renderer to read them back from)
			var buffer := PackedFloat32Array()
			for i in per_kind[k].size():
				var at: Vector3 = per_kind[k][i]
				var s := rng.randf_range(TREE_SCALE_MIN, TREE_SCALE_MAX)
				var yaw := deg_to_rad(float(rng.randi() % 360))
				var basis := Basis(Vector3.UP, yaw).scaled(Vector3(s, s, s))
				var b := _round_basis(basis)
				var o := Vector3(snappedf(at.x, 0.01), snappedf(at.y - TREE_SINK_M, 0.01), snappedf(at.z, 0.01))
				# MultiMesh's 3D layout: the 3 x 4 matrix, row by row (basis rows, then the origin's component)
				buffer.append_array(PackedFloat32Array([b.x.x, b.y.x, b.z.x, o.x, b.x.y, b.y.y, b.z.y, o.y, b.x.z, b.y.z, b.z.z, o.z]))
			var inst := MultiMeshInstance3D.new()
			inst.name = "chunk_%d_%d_%s" % [key.x, key.y, ["cone", "lollipop"][k]]
			inst.multimesh = mm
			inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			inst.visibility_range_end = VISIBILITY_END_M[_size]
			inst.visibility_range_end_margin = 40.0
			holder.add_child(inst)
			inst.owner = owner_node
			_buffers["%s/%s" % [name, inst.name]] = buffer
			trees += per_kind[k].size()
	print("[build]   ", _size, " ", name, ": ", trees, " trees in ", keys.size(), " chunks (", snappedf(float(area["area_m2"]) / 1.0e6, 0.001), " km2)")
	return Vector2i(trees, keys.size())

func _round_basis(b: Basis) -> Basis:
	## Three decimals: keeps the generated scene's text small.
	return Basis(Vector3(snappedf(b.x.x, 0.001), snappedf(b.x.y, 0.001), snappedf(b.x.z, 0.001)),
		Vector3(snappedf(b.y.x, 0.001), snappedf(b.y.y, 0.001), snappedf(b.y.z, 0.001)),
		Vector3(snappedf(b.z.x, 0.001), snappedf(b.z.y, 0.001), snappedf(b.z.z, 0.001)))

func _blocked(p: Vector2) -> bool:
	for m in _markers:
		if m.distance_to(p) < MARKER_CLEAR_M:
			return true
	for loop in _water_loops:
		if Geometry2D.is_point_in_polygon(p, loop):
			return true
	return false

func _slope(p: Vector2) -> float:
	var here := _ground.y_at(p.x, p.y)
	var steepest := 0.0
	for k in 4:
		var d := Vector2.RIGHT.rotated(k * PI / 2.0) * 3.0
		var g := _ground.y_at(p.x + d.x, p.y + d.y)
		if not is_nan(g):
			steepest = maxf(steepest, absf(g - here) / 3.0)
	return steepest

# --- water ---

func _make_water(waters: Node3D, owner_node: Node, name: String, area: Dictionary, crossings: Array[Vector3]) -> int:
	var verts: Array = area["vertices"]
	var kind := "sea" if area["kind"] == "sea" else "river" if name.to_lower().contains(RIVER_WORD) else "lake"
	var loops: Array[PackedVector2Array] = []
	for outline in area["outlines"]:
		var loop := PackedVector2Array()
		for p in outline:
			loop.append(Vector2(p[0], p[1]))
		if Geometry2D.is_polygon_clockwise(loop):
			loop.reverse()
		loops.append(loop)
	var bank := _bank_samples(loops)
	var level := NAN
	match kind:
		"sea":
			level = float(area["level"])
		"lake":
			var lowest := INF
			for b in bank:
				lowest = minf(lowest, b.y)
			level = (lowest if lowest < INF else 0.0) - LAKE_BELOW_RIM_M * _tall_scale()
	var tris: Array = []
	for t in area["triangles"]:
		var a := Vector2(verts[t[0]][0], verts[t[0]][1])
		var b := Vector2(verts[t[1]][0], verts[t[1]][1])
		var c := Vector2(verts[t[2]][0], verts[t[2]][1])
		if kind == "river":
			_split_river(tris, a, b, c)
		else:
			tris.append([a, b, c])
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var count := 0
	for t in tris:
		# wound clockwise seen from above (Godot's front face), so the surface faces up
		var a: Vector2 = t[0]
		var b: Vector2 = t[1]
		var c: Vector2 = t[2]
		if (b - a).cross(c - a) < 0.0:
			var tmp := b
			b = c
			c = tmp
		for p in [a, b, c]:
			var y := level if not is_nan(level) else _nearest_bank(bank, p) - RIVER_BELOW_BANK_M * _tall_scale()
			st.set_normal(Vector3.UP)
			st.add_vertex(Vector3(snappedf(p.x, 0.01), snappedf(y, 0.01), snappedf(p.y, 0.01)))
			count += 1
	var body := WATER_SCENE.instantiate() as Node3D
	body.name = name
	waters.add_child(body)
	body.owner = owner_node
	owner_node.set_editable_instance(body, true)   # so pack() keeps the mesh, shapes and blockers set inside it
	(body.get_node("Surface") as MeshInstance3D).mesh = st.commit()
	var blocked := 0
	if kind == "lake":
		(body.get_node("Wall/Shape") as CollisionShape3D).disabled = true   # the lake can be waded
	else:
		var shapes := loops
		if kind == "river":
			shapes = _open_crossings(loops, crossings)
		blocked = _block(body, owner_node, shapes, bank, level)
	print("[build]   ", _size, " ", name, ": ", kind, "" if is_nan(level) else " at %s m" % snappedf(level, 0.01), ", ", count / 3, " triangles, ", blocked, " blockers")
	return count

func _bank_samples(loops: Array[PackedVector2Array]) -> PackedVector3Array:
	## Points along the outlines every BANK_SAMPLE_M, as (x, ground height, z); none off the ground.
	var out := PackedVector3Array()
	var step := BANK_SAMPLE_M * _edge_scale()
	for loop in loops:
		for i in loop.size():
			var a := loop[i]
			var b := loop[(i + 1) % loop.size()]
			var n := maxi(1, ceili(a.distance_to(b) / step))
			for k in n:
				var p := a.lerp(b, float(k) / n)
				var g := _ground.y_at(p.x, p.y)
				if not is_nan(g):
					out.append(Vector3(p.x, g, p.y))
	return out

func _nearest_bank(bank: PackedVector3Array, p: Vector2) -> float:
	var best := INF
	var y := 0.0
	for b in bank:
		var d := Vector2(b.x - p.x, b.z - p.y).length_squared()
		if d < best:
			best = d
			y = b.y
	return y

func _crossings(size: String, wide: float) -> Array[Vector3]:
	## The RiverCrossings hung under his markers in the 2 km landscape scene, on this size's map: (x, radius, z).
	var out: Array[Vector3] = []
	var state := (load(LANDSCAPE_SOURCE) as PackedScene).get_state()
	var default_radius := float((load(CROSSING_SCENE) as PackedScene).instantiate().get("radius_m"))
	var land: Node = (load(LANDSCAPE_GLB % size) as PackedScene).instantiate()
	for i in state.get_node_count():
		var scene := state.get_node_instance(i)
		if scene == null or scene.resource_path != CROSSING_SCENE:
			continue
		var offset := Transform3D.IDENTITY
		var radius := default_radius
		for k in state.get_node_property_count(i):
			match String(state.get_node_property_name(i, k)):
				"transform":
					offset = state.get_node_property_value(i, k)
				"radius_m":
					radius = state.get_node_property_value(i, k)
		var marker := land.get_node_or_null(String(state.get_node_path(i, true)).trim_prefix("./")) as Node3D
		if marker == null:
			push_warning("%s: a river crossing hangs under %s, which this map has no marker for" % [size, state.get_node_path(i, true)])
			continue
		var at := marker.transform * (offset.origin * wide)
		out.append(Vector3(at.x, radius * wide, at.z))
	land.free()
	return out

func _open_crossings(loops: Array[PackedVector2Array], crossings: Array[Vector3]) -> Array[PackedVector2Array]:
	## The river's outlines with a disc around each crossing cut out (the pieces left are what blocks).
	var shapes := loops.duplicate()
	for c in crossings:
		var disc := PackedVector2Array()
		for k in CROSSING_SIDES:
			disc.append(Vector2(c.x, c.z) + Vector2.RIGHT.rotated(TAU * k / CROSSING_SIDES) * c.y)
		var next: Array[PackedVector2Array] = []
		for shape in shapes:
			for piece in Geometry2D.clip_polygons(shape, disc):
				if Geometry2D.is_polygon_clockwise(piece):
					push_warning("%s: a river crossing at (%d, %d) lies inside the river without reaching a bank; widen it" % [_size, c.x, c.z])
					continue
				next.append(piece)
		shapes = next
	return shapes

func _block(body: Node3D, owner_node: Node, shapes: Array[PackedVector2Array], bank: PackedVector3Array, level: float) -> int:
	## A navmesh blocker per shape (under Blockers) and a wall along every edge of the shapes (Wall/Shape).
	var low := INF
	var high := -INF
	for b in bank:
		low = minf(low, b.y)
		high = maxf(high, b.y)
	if not is_nan(level):
		low = minf(low, level)
	var pad := BLOCKER_PAD_M * _tall_scale()
	var blockers := body.get_node("Blockers")
	var faces := PackedVector3Array()
	for shape in shapes:
		var obstacle := NavigationObstacle3D.new()
		obstacle.name = "Blocker%d" % blockers.get_child_count()
		obstacle.avoidance_enabled = false
		obstacle.affect_navigation_mesh = true
		obstacle.carve_navigation_mesh = true
		obstacle.position = Vector3(0.0, snappedf(low - pad, 0.01), 0.0)
		obstacle.height = snappedf(high - low + 2.0 * pad, 0.01)
		var outline := PackedVector3Array()
		for p in shape:
			outline.append(Vector3(snappedf(p.x, 0.01), 0.0, snappedf(p.y, 0.01)))
		obstacle.vertices = outline
		blockers.add_child(obstacle)
		obstacle.owner = owner_node
		for i in shape.size():
			var a := shape[i]
			var b := shape[(i + 1) % shape.size()]
			var ga := _ground.y_at(a.x, a.y)
			var gb := _ground.y_at(b.x, b.y)
			if is_nan(ga) and is_nan(gb):
				continue   # off the map
			ga = gb if is_nan(ga) else ga
			gb = ga if is_nan(gb) else gb
			var bottom := minf(minf(ga, gb), level if not is_nan(level) else INF) - WALL_DEPTH_M * _tall_scale()
			var top := maxf(ga, gb) + WALL_HEIGHT_M
			if is_nan(level):   # the river (only it follows the ground instead of one water level)
				bottom = minf(ga, gb) - RIVER_WALL_BELOW_M
				top = maxf(ga, gb) + RIVER_WALL_ABOVE_M
			faces.append_array(PackedVector3Array([Vector3(a.x, bottom, a.y), Vector3(b.x, bottom, b.y), Vector3(b.x, top, b.y),
				Vector3(a.x, bottom, a.y), Vector3(b.x, top, b.y), Vector3(a.x, top, a.y)]))
	var wall := ConcavePolygonShape3D.new()
	wall.backface_collision = true
	wall.set_faces(faces)
	(body.get_node("Wall/Shape") as CollisionShape3D).shape = wall
	return shapes.size()

func _split_river(out: Array, a: Vector2, b: Vector2, c: Vector2) -> void:
	## Splits the triangle's longest edge at its midpoint until none is longer than RIVER_EDGE_M (scaled by the width of
	## the map so a 6 km river is not 9 times the triangles), so the strip can follow its banks.
	var edges := [a.distance_to(b), b.distance_to(c), c.distance_to(a)]
	var longest := 0
	for i in 3:
		if edges[i] > edges[longest]:
			longest = i
	if edges[longest] <= RIVER_EDGE_M * _edge_scale():
		out.append([a, b, c])
		return
	match longest:
		0:
			var m := (a + b) * 0.5
			_split_river(out, a, m, c)
			_split_river(out, m, b, c)
		1:
			var m := (b + c) * 0.5
			_split_river(out, a, b, m)
			_split_river(out, a, m, c)
		_:
			var m := (c + a) * 0.5
			_split_river(out, a, b, m)
			_split_river(out, m, b, c)

func _tall_scale() -> float:
	return {"400m": 0.2, "2km": 1.0, "6km": 5.0}[_size]

func _edge_scale() -> float:
	return {"400m": 0.2, "2km": 1.0, "6km": 3.0}[_size]
